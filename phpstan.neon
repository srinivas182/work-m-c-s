includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    phpVersion: 80300
    paths:
        - app
        - modules
        - bootstrap/app.php
    excludePaths:
        - modules/*/stubs/*
        - modules/*/tests/*
    tmpDir: .phpstan-cache
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Traits under Contracts/ are published for other modules to use; until a
        # module uses one, PHPStan reports it as unused.
        - identifier: trait.unused
          path: modules/*/src/Contracts/*

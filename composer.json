{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wurk/platform",
    "type": "project",
    "description": "WURK — multi-tenant business platform",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.1",
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/framework": "^13.17",
        "laravel/octane": "^2.22",
        "laravel/pennant": "^1.26",
        "laravel/tinker": "^3.0",
        "league/flysystem-path-prefixing": "^3.31"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Wurk\\Platform\\": "modules/Platform/src/",
            "Wurk\\Health\\": "modules/Health/src/",
            "Wurk\\Tenancy\\": "modules/Tenancy/src/",
            "Wurk\\Identity\\": "modules/Identity/src/",
            "Wurk\\Access\\": "modules/Access/src/",
            "Wurk\\Audit\\": "modules/Audit/src/",
            "Wurk\\Admin\\": "modules/Admin/src/",
            "Wurk\\Plans\\": "modules/Plans/src/",
            "Wurk\\Features\\": "modules/Features/src/",
            "Wurk\\Regions\\": "modules/Regions/src/",
            "Wurk\\Messaging\\": "modules/Messaging/src/",
            "Wurk\\Credits\\": "modules/Credits/src/",
            "Wurk\\Security\\": "modules/Security/src/",
            "Wurk\\Onboarding\\": "modules/Onboarding/src/",
            "Wurk\\Marketing\\": "modules/Marketing/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Wurk\\Platform\\Tests\\": "modules/Platform/tests/",
            "Wurk\\Health\\Tests\\": "modules/Health/tests/",
            "Wurk\\Tenancy\\Tests\\": "modules/Tenancy/tests/",
            "Wurk\\Identity\\Tests\\": "modules/Identity/tests/",
            "Wurk\\Access\\Tests\\": "modules/Access/tests/",
            "Wurk\\Audit\\Tests\\": "modules/Audit/tests/",
            "Wurk\\Admin\\Tests\\": "modules/Admin/tests/",
            "Wurk\\Plans\\Tests\\": "modules/Plans/tests/",
            "Wurk\\Features\\Tests\\": "modules/Features/tests/",
            "Wurk\\Regions\\Tests\\": "modules/Regions/tests/",
            "Wurk\\Messaging\\Tests\\": "modules/Messaging/tests/",
            "Wurk\\Credits\\Tests\\": "modules/Credits/tests/",
            "Wurk\\Security\\Tests\\": "modules/Security/tests/",
            "Wurk\\Onboarding\\Tests\\": "modules/Onboarding/tests/",
            "Wurk\\Marketing\\Tests\\": "modules/Marketing/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

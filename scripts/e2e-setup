#!/usr/bin/env bash
# Prepares an isolated environment for browser tests (.env.e2e + SQLite files),
# with one business and its owner. Never touches .env.
#   ./scripts/e2e-setup && pnpm build && APP_ENV=e2e pnpm test:e2e
set -euo pipefail
cd "$(dirname "$0")/.."

root="$(pwd)"
cp .env.example .env.e2e
sed -i \
  -e 's/^APP_ENV=.*/APP_ENV=e2e/' \
  -e 's/^DB_CONNECTION=.*/DB_CONNECTION=sqlite/' \
  -e '/^DB_\(HOST\|PORT\|DATABASE\|USERNAME\|PASSWORD\)=/d' \
  -e 's/^SESSION_DRIVER=.*/SESSION_DRIVER=file/' \
  -e 's/^CACHE_STORE=.*/CACHE_STORE=file/' \
  -e 's/^QUEUE_CONNECTION=.*/QUEUE_CONNECTION=sync/' \
  -e 's/^MAIL_MAILER=.*/MAIL_MAILER=log/' \
  .env.e2e
cat >> .env.e2e <<ENV
DB_DATABASE=${root}/database/e2e.sqlite
WURK_DESIGN_SHOWCASE=true
WURK_ROOT_DOMAIN=wurk.test
WURK_APP_DOMAIN=127.0.0.1
WURK_ADMIN_DOMAIN=localhost
# The whole browser suite signs in and signs up from one IP: room above the production limit of 20 codes/hour.
WURK_OTP_PER_IP_PER_HOUR=500
ENV

export APP_ENV=e2e
rm -f database/e2e.sqlite database/e2e-shard.sqlite
touch database/e2e.sqlite
php artisan key:generate --force --no-interaction
php artisan migrate --force --no-interaction
# Start from a clean slate: rate limits (e.g. signups per IP) live in the cache.
php artisan cache:clear --no-interaction > /dev/null
php artisan shards:register e2e-shard --driver=sqlite --database="${root}/database/e2e-shard.sqlite"
php artisan tenants:create "Glow Salon" --handle=glow-salon
# Categories and sample designs, so signup shows the category and design steps.
php artisan website:seed-sample-templates --no-interaction > /dev/null
php artisan website:install-templates --no-interaction > /dev/null
php artisan identities:create owner@glow.co.za --first=Thandi --last=Mokoena \
  --password="sunny days in durban" --tenant=glow-salon
# WURK staff for admin browser tests, one per Playwright project (authenticator
# codes are single-use, so two projects must not share an account).
for project in desktop mobile; do
  php artisan identities:create "ops-${project}@wurk.co.za" --first=Lerato --last=Ops \
    --password="sunny days in durban" --staff --mfa-secret=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
done

# Example packages for the pricing page and signup.
php artisan packages:seed-placeholders

# A published demo site per template: public-page accessibility scans and the performance gate.
if [ ! -f bootstrap/site-render/site-render.js ]; then
  echo "The website renderer isn't built: run 'pnpm build' first (demo sites are published, which renders them)." >&2
  exit 1
fi
php artisan website:demo-sites --no-interaction > /dev/null
php artisan bookings:demo --no-interaction > /dev/null   # the demo sites take bookings

#!/usr/bin/env bash
# Prints the test folders (or files) for one part of the MySQL test run (CI splits it in eight).
# Parts 1-4, 6 and 7 are explicit lists of database-heavy modules; part 5 is everything else — so a new module
# is always tested (it lands in part 5), and no test can be left out of every part.
# Five parts (14.8a): each ran 5-6.5 min normally, so a slow runner (+3 min) pushed one past 10 three times.
set -euo pipefail
cd "$(dirname "$0")/.."
PART1=(Records Health Regions Data Success Website) # Website back from part 7 (19.5): part 7 reached 12 min with the receptionist and sales tests; part 1 took 2 min # Admin to part 2: part 1 reached 10m17s (15.5c); Data, Success from part 5 (18.0b)
PART2=(Admin Identity Audit Team Referrals) # Tenancy now in part 5 ("everything else"): part 2 timed out at 9m10s (15.1b); Messaging, Sales, Portal to part 7 (21.2: 12 min on a slow runner)
PART3=(Bookings Access) # Plans, Features to part 5 (v0.23.0: part 3 took 10.9 min on a slow runner)
PART7=(Ai Security Marketing Messaging Sales Portal Support Watchtower Shop) # 19.2: part 3 passed 12 min on a slow runner; the receptionist adds Ai tests. Part 7 took 1.5 min (21.2)
# Website's slowest files run in part 8 (20.1): Website alone takes ~8.5 min on MySQL, and part 1 with all of it was
# cancelled at 12 min. Website's other files stay in part 1 (~4.5 min with the rest of part 1).
WEBSITE_PART8=(QuoteFormTest SiteModelTest PhotoUploadTest ChatBotTest ReceptionistTest VideoUploadTest TemplatePhotosTest WhatsAppChatsTest WhatsAppReceptionistTest VoiceNotesTest) # WhatsApp (21)
website_files() { # $1 = in | out (of WEBSITE_PART8)
  find modules/Website/tests -name '*Test.php' | sort | while read -r f; do
    b="$(basename "$f" .php)"
    if in_list "$b" "${WEBSITE_PART8[@]}"; then [[ "$1" == in ]] && echo "$f"; else [[ "$1" == out ]] && echo "$f"; fi
  done
}
PART6=(Tenancy Agents Crm) # Tenancy on its own (18.4b): moves, restores and rollouts migrate several MySQL shards per test (~6 min); part 3 with it passed 12 min. Agents, Crm from part 5 (10.5 min) to part 6 (4.5 min) — 21.2
PART4=(Payments Billing) # money; Shop to part 7 and Credits to part 5 (v0.23.0: part 4 reached 12 min on a slow runner with Sprint 22's payment tests)
in_list() { local x="$1"; shift; for y in "$@"; do [[ "$x" == "$y" ]] && return 0; done; return 1; }
case "${1:-}" in
  1) for m in "${PART1[@]}"; do
       if [[ "$m" == Website ]]; then website_files out; elif [[ -d "modules/$m/tests" ]]; then echo "modules/$m/tests"; fi
     done ;;
  8) website_files in ;;
  2) for m in "${PART2[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  3) for m in "${PART3[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  4) for m in "${PART4[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  6) for m in "${PART6[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  7) for m in "${PART7[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  5) echo tests
     for d in modules/*/tests; do m="${d#modules/}"; m="${m%/tests}"
       in_list "$m" "${PART1[@]}" || in_list "$m" "${PART2[@]}" || in_list "$m" "${PART3[@]}" || in_list "$m" "${PART4[@]}" || in_list "$m" "${PART6[@]}" || in_list "$m" "${PART7[@]}" || echo "$d"; done ;;
  *) echo "usage: $0 1|2|3|4|5|6|7|8" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# Prints the test folders for one part of the MySQL test run (CI splits it in four).
# Parts 1-3 are explicit lists of database-heavy modules; part 4 is everything else — so a new module
# is always tested (it lands in part 3), and no test can be left out of every part.
set -euo pipefail
cd "$(dirname "$0")/.."
PART1=(Website Records Health Admin Regions)
PART2=(Identity Messaging Audit Team)
PART3=(Bookings Access Payments Credits Ai Plans Features Security Marketing)
in_list() { local x="$1"; shift; for y in "$@"; do [[ "$x" == "$y" ]] && return 0; done; return 1; }
case "${1:-}" in
  1) for m in "${PART1[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  2) for m in "${PART2[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  3) for m in "${PART3[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  4) echo tests
     for d in modules/*/tests; do m="${d#modules/}"; m="${m%/tests}"
       in_list "$m" "${PART1[@]}" || in_list "$m" "${PART2[@]}" || in_list "$m" "${PART3[@]}" || echo "$d"; done ;;
  *) echo "usage: $0 1|2|3|4" >&2; exit 2 ;;
esac

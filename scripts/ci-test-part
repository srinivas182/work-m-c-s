#!/usr/bin/env bash
# Prints the test folders for one part of the MySQL test run (CI splits it in five).
# Parts 1-4 are explicit lists of database-heavy modules; part 5 is everything else — so a new module
# is always tested (it lands in part 5), and no test can be left out of every part.
# Five parts (14.8a): each ran 5-6.5 min normally, so a slow runner (+3 min) pushed one past 10 three times.
set -euo pipefail
cd "$(dirname "$0")/.."
PART1=(Website Records Health Regions) # Admin to part 2: part 1 reached 10m17s (15.5c)
PART2=(Admin Identity Messaging Audit Team Referrals Sales Portal) # Tenancy now in part 5 ("everything else"): part 2 timed out at 9m10s (15.1b)
PART3=(Bookings Access Ai Plans Features Security Marketing)
PART4=(Payments Credits Billing Shop) # money
in_list() { local x="$1"; shift; for y in "$@"; do [[ "$x" == "$y" ]] && return 0; done; return 1; }
case "${1:-}" in
  1) for m in "${PART1[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  2) for m in "${PART2[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  3) for m in "${PART3[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  4) for m in "${PART4[@]}"; do [[ -d "modules/$m/tests" ]] && echo "modules/$m/tests"; done ;;
  5) echo tests
     for d in modules/*/tests; do m="${d#modules/}"; m="${m%/tests}"
       in_list "$m" "${PART1[@]}" || in_list "$m" "${PART2[@]}" || in_list "$m" "${PART3[@]}" || in_list "$m" "${PART4[@]}" || echo "$d"; done ;;
  *) echo "usage: $0 1|2|3|4|5" >&2; exit 2 ;;
esac

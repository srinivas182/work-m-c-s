{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr && vite build --ssr resources/js/site-render.tsx --outDir bootstrap/site-render",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"resources/**/*.{ts,tsx,css}\" \"modules/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"resources/**/*.{ts,tsx,css}\" \"modules/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "tokens": "tsx scripts/generate-tokens.ts",
    "test:e2e": "playwright test",
    "fonts:fallbacks": "node scripts/font-fallbacks.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/work-sans": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@inertiajs/react": "^3.11.0",
    "@puckeditor/core": "0.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capsizecss/metrics": "^4.4.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chokidar": "^6.0.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "laravel-vite-plugin": "^3.2.1",
    "lighthouse": "13",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "happy-dom": "^21.0.4"
    }
  }
}

# ---------------------------------------------------------------------------
# WURK — local development defaults (Docker Compose). No secrets belong here.
# ---------------------------------------------------------------------------
APP_NAME=WURK
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

OCTANE_SERVER=frankenphp

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wurk
DB_USERNAME=wurk
DB_PASSWORD=wurk

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=wurk

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=local-dev-master-key

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@wurk.co.za"
MAIL_FROM_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

# Malware scanning of files visitors attach to forms (ClamAV clamd)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Support tickets (Sprint 16.3): WURK’s support inbox
WURK_SUPPORT_EMAIL=support@wurk.co.za
# Security headers (Sprint 18.1): Content Security Policy enforce | report-only | off; HSTS over HTTPS; who receives security reports.
WURK_CSP=enforce
WURK_HSTS=true
WURK_SECURITY_EMAIL=security@wurk.co.za
# The load balancer's addresses (comma-separated), or * when the servers are reachable only through it (Sprint 18.1).
TRUSTED_PROXIES=
# Watchtower (Sprint 18.0): problem reports go here until HQ sets its own list in Admin → Watchtower (comma-separated).
WATCHTOWER_EMAIL=
# Set at build time so incidents show which release they happened in (defaults to the VERSION file).
WURK_RELEASE=
WURK_COMMIT=
# Watchtower 18.0b: the secret in the uptime checker's webhook address (https://<app domain>/_wurk/uptime/<token>, 16+ letters/digits); the AI explanation and its daily cap.
WATCHTOWER_UPTIME_TOKEN=
WATCHTOWER_AI=true
WATCHTOWER_AI_DAILY_CAP=50
